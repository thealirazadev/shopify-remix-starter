generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Required by the Prisma session storage adapter. Fields match the adapter's
// expected shape; do not rename them.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// Small example model demonstrating a per-shop settings record read and
// written by the sample admin page. Delete or replace when building a real
// app.
model ShopSetting {
  id        String   @id @default(cuid())
  shop      String   @unique
  label     String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
