# Shopify app API key (Client ID) from the Partner Dashboard.
SHOPIFY_API_KEY=00000000000000000000000000000000

# Shopify app API secret (Client Secret) from the Partner Dashboard. Keep private.
SHOPIFY_API_SECRET=shpss_0000000000000000000000000000000000000000

# Comma-separated access scopes the app requests during OAuth.
SCOPES=read_products,write_products

# Public HTTPS URL where the app is reachable (tunnel URL in dev, real domain in prod).
SHOPIFY_APP_URL=https://example-tunnel.trycloudflare.com

# Prisma database connection string for the SQLite file. The provider is set in
# prisma/schema.prisma; another database needs that provider changed, not only this URL.
DATABASE_URL=file:./dev.sqlite

# Optional. Set to true to require the demo subscription on the billing demo route.
# BILLING_ENABLED=false

# Optional. Billing requests are test charges unless NODE_ENV=production. Set to true or
# false to decide explicitly (for example true on a production-mode staging deploy).
# BILLING_TEST=true
